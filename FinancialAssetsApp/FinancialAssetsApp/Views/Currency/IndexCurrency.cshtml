@model IEnumerable<FinancialAssetsApp.Models.Currency>
@{
    ViewData["Title"] = "Валюта";
}
<h2>Моя валюта</h2>
<div class="container">
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Код валюты</th>
                <th>Название валюты</th>
                <th>Цена покупки</th>
                <th>Изменение</th>
                <th>Текущая цена</th>
                <th>Сумма валюты</th>
                <th>Стоимость в рублях</th>
                <th>Дата добавления</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CharCode</td>
                    <td>@item.NameCurrency</td>
                    <td>@item.Price ₽</td>
                    <td style="font-weight: bold" class="change-price">Загрузка...</td>
                    <td class="current-price">Загрузка...</td>
                    <td>@item.AmountCurrency</td>
                    <td>@item.SumCurrencyToRuble ₽</td>
                    <td>@item.DateAddStock.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <!--
        <a asp-action="FixSums" class="btn btn-secondary">Пересчитать старые суммы</a> // Если добавится новый столбец в БД
    -->  
    <a asp-action="CreateCurrency" class="btn btn-primary">Добавить валюту</a>
</div>

<h2>Круговая диаграмма распределения валюты</h2>
<div class="d-flex gap-4">
    <div class="text-center">
        <canvas style="width: 450px; height: 450px" id="TickerPie"></canvas>
        <h3>По Компаниям</h3>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
